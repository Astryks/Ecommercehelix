# ---- Ecommerce Helix environment ----
# Everything is optional for local dev: with nothing set the app runs in DEMO MODE
# (dev login, in-memory data, Stripe checkout simulated).

# Auth.js (required in production). Generate with: npx auth secret
AUTH_SECRET=
# Google sign-in (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic links via Resend (optional, needs DATABASE_URL)
AUTH_RESEND_KEY=
EMAIL_FROM="Ecommerce Helix <login@ecommercehelix.com>"
# Allow the demo "dev login" even when real providers are configured (never in prod)
ALLOW_DEV_LOGIN=false

# Postgres (Neon, Vercel Postgres, Supabase...). Without it, data is in memory.
DATABASE_URL=

# Stripe (test mode). Without these, checkout is simulated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Public base URL (used for Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000
