# ---- Ecommerce Helix environment ----
# Everything is optional for local dev: with nothing set the app runs in DEMO MODE
# (dev login, in-memory data, Stripe checkout simulated).

# Auth.js (required in production). Generate with: npx auth secret
AUTH_SECRET=
# Google sign-in (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic links via Resend (optional, needs DATABASE_URL)
AUTH_RESEND_KEY=
EMAIL_FROM="Ecommerce Helix <login@ecommercehelix.com>"
# Demo login: on automatically while no Google or Resend login is configured. Each demo sign-in
# creates a new isolated test account. true keeps it on next to real providers in local dev only
# (ignored in production).
ALLOW_DEV_LOGIN=false

# Postgres (Neon, Vercel Postgres, Supabase...). Without it, data is in memory.
DATABASE_URL=

# Stripe (test mode). Without these, checkout is simulated.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=

# Public base URL (used for Stripe redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Meta (Facebook and Instagram ads). Without META_APP_ID the app uses mock Meta data outside production.
# See docs/meta-setup.md
META_APP_ID=
META_APP_SECRET=
META_CONFIG_ID=
# 32 bytes: openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
# Vercel Cron sends this as a Bearer token to /api/cron/meta-sync: openssl rand -hex 32
CRON_SECRET=
# 1 = seasonal nudge cron really sends email (needs AUTH_RESEND_KEY and EMAIL_FROM)
NUDGES_LIVE=
# Stable public URL for OAuth redirects in production
APP_URL=
# Set to 1 to force mock Meta data
META_MOCK=

# Shopify (public app in the Shopify Partner / Dev Dashboard). Without both, Shopify shows "coming soon". See docs/shopify-setup.md.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# SHOPIFY_API_VERSION=2026-10

# Google Ads. Without all three, Google Ads shows "coming soon". See docs/google-ads-setup.md.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_DEVELOPER_TOKEN=
# GOOGLE_ADS_API_VERSION=v25

# AI (Vercel AI Gateway). On Vercel, OIDC (VERCEL_OIDC_TOKEN) authenticates automatically; elsewhere set AI_GATEWAY_API_KEY.
# Without either, every AI button returns Helix's rule-based advice. See docs/ai-setup.md.
AI_GATEWAY_API_KEY=
# AI_MODEL=google/gemini-2.5-flash-lite
# AI_MONTHLY_BUDGET_USD=25   # global kill-switch: all AI calls stop for the month once logged spend reaches this
# AI_DISABLED=1              # turn AI off completely
