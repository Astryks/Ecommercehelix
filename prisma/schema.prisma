// E-commerce Helix minimal schema (v1). Run: npx prisma migrate dev
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ---------- Auth.js tables ----------
model User {
  id                  String               @id @default(cuid())
  name                String?
  email               String?              @unique
  emailVerified       DateTime?
  image               String?
  createdAt           DateTime             @default(now())
  track               String               @default("growing") // "starting" | "growing"
  country             String               @default("AU") // ISO 3166 alpha-2, drives the calendar and tax default
  salesTaxMode        String               @default("auto") // "auto" | "AU" | "NZ" | "UK" | "none": strip GST/VAT from sales
  onboardedAt         DateTime?
  isDemo              Boolean              @default(false) // created by the demo login; never linked to a real account
  accounts            Account[]
  sessions            Session[]
  stores              Store[]
  subscription        Subscription?
  completions         TaskCompletion[]
  approvals           Approval[]
  scorecardDays       ScorecardDay[]
  productSales        ProductSale[]
  settings            ScorecardSettings?
  metaConnection      MetaConnection?
  metaSnapshot        MetaSnapshot?
  metaDrafts          MetaDraft[]
  auditLogs           AuditLog[]
  seasonPlans         SeasonPlan[]
  suppliers           Supplier[]
  stockItems          StockItem[]
  monthlyGoals        MonthlyGoals?
  lessonProgress      LessonProgress[]
  courseState         CourseState?
  profitSetup         ProfitSetup?
  progressEvents      ProgressEvent[]
  stockSeeded         Boolean              @default(false) // example suppliers and stock added once
  diagnosis           Json? // answers to the onboarding questions, plus the bottleneck and starting goal
  diagnosedAt         DateTime?
  planStartedAt       DateTime? // when the personal 12-week plan started
  auditRuns           AuditRun[]
  shopifyConnection   ShopifyConnection?
  googleAdsConnection GoogleAdsConnection?
  googleAdsSnapshot   GoogleAdsSnapshot?
  googleAdsDrafts     GoogleAdsDraft[]
  tiktokConnection    TikTokConnection?
  ga4Property         Ga4Property?
  aiUsage             AiUsage[]
  aiCache             AiCache[]
  coachUsage          CoachUsage[]
  coachMemory         CoachMemory[]
  coachMessages       CoachMessage[]
  coachTasks          CoachTask[]
  wins                Win[]
  reviewRequests      ReviewRequest[]
  achievementsSeen    AchievementSeen[]
  promoDrafts         PromoDraft[]
  emailPrefs          EmailPrefs?
  emailsSent          EmailSent[]
  toolInputs          ToolInput[]
  toolSnapshots       ToolSnapshot[]
  toolAlerts          ToolAlert[]
  weeklyReviews       WeeklyReview[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ---------- Helix ----------
enum Plan {
  FREE
  STARTER
  GROWTH
}

model Store {
  id        String   @id @default(cuid())
  userId    String
  url       String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                   String   @id @default(cuid())
  userId               String   @unique
  plan                 Plan     @default(FREE)
  status               String   @default("active")
  stripeCustomerId     String?
  stripeSubscriptionId String?
  walletBalanceCents   Int      @default(0)
  cancelAtPeriodEnd    Boolean  @default(false)
  currentPeriodEnd     DateTime?
  priceId              String?
  lastEventAt          DateTime? // created time of the newest Stripe event applied (ignores older, out-of-order events)
  updatedAt            DateTime @updatedAt
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Task templates live in code (src/lib/seed/tasks.ts); this table mirrors them for analytics.
model Task {
  id      String @id
  area    String
  title   String
  minutes Int
  tier    Plan   @default(FREE)
}

model TaskCompletion {
  id          String   @id @default(cuid())
  userId      String
  taskId      String
  completedOn String // YYYY-MM-DD in the user's time zone
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, taskId])
}

model Approval {
  id        String    @id @default(cuid())
  userId    String
  taskId    String
  title     String
  detail    String
  estAiCost Float     @default(0.01)
  status    String    @default("pending") // pending | approved | rejected | expired
  createdAt DateTime  @default(now())
  decidedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScorecardSettings {
  userId               String @id
  monthlyRevenueTarget Float  @default(60000)
  targetMerPct         Float  @default(30)
  fixedCostsMonthly    Float  @default(9000)
  user                 User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Monthly goals ladder, set in onboarding or on /dashboard/goals. MER target lives in ScorecardSettings.
model MonthlyGoals {
  userId          String   @id
  sessions        Int      @default(30000)
  ctrPct          Float    @default(1.2)
  atcPct          Float    @default(7.5)
  crPct           Float    @default(2.2)
  aov             Float    @default(92)
  cpa             Float    @default(28)
  contributionPct Float    @default(20)
  netProfit       Float    @default(3000)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ScorecardDay {
  id                 String  @id @default(cuid())
  userId             String
  date               String // YYYY-MM-DD
  orders             Int     @default(0)
  newCustomerOrders  Int     @default(0)
  units              Int     @default(0)
  sessions           Int     @default(0)
  addToCarts         Int     @default(0) // sessions with an add to cart (optional)
  revenue            Float   @default(0) // gross sales
  newCustomerRevenue Float   @default(0)
  discounts          Float   @default(0)
  refunds            Float   @default(0)
  cogs               Float   @default(0)
  shipping           Float   @default(0)
  paymentFees        Float   @default(0)
  adMeta             Float   @default(0)
  adGoogle           Float   @default(0)
  adTiktok           Float   @default(0)
  adOther            Float   @default(0)
  otherMarketing     Float   @default(0)
  metaRevenue        Float   @default(0) // platform-attributed, for channel ROAS
  googleRevenue      Float   @default(0)
  tiktokRevenue      Float   @default(0)
  source             String  @default("manual") // manual | quick | csv | csv-orders (orders export, tax-included prices) | shopify | meta | google
  example            Boolean @default(false)
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

model ProductSale {
  id       String  @id @default(cuid())
  userId   String
  date     String
  sku      String
  name     String
  units    Int
  price    Float // average selling price per unit
  unitCost Float // landed COGS per unit
  example  Boolean @default(false)
  source   String  @default("manual") // manual | shopify
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- Meta integration ----------
// The access token is stored only as AES-256-GCM ciphertext (src/lib/crypto.ts), never in plain text.
model MetaConnection {
  userId            String    @id
  mode              String    @default("live") // live | mock
  fbUserId          String
  fbUserName        String    @default("")
  tokenEnc          String
  tokenExpiresAt    DateTime?
  scopes            String    @default("") // comma separated, as granted
  adAccountId       String? // act_123
  adAccountName     String?
  currency          String?
  timezone          String?
  pageId            String?
  pageName          String?
  instagramId       String?
  instagramUsername String?
  pixelId           String?
  pixelName         String?
  status            String    @default("active") // active | error | expired
  lastSyncAt        DateTime?
  lastSyncError     String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Latest synced insights (last 7 days, previous 7 days and daily spend) as JSON.
model MetaSnapshot {
  userId   String   @id
  data     String
  syncedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Paused drafts Helix created after an approval.
model MetaDraft {
  id          String   @id @default(cuid())
  userId      String
  approvalId  String?
  status      String // created | partial | failed
  campaignId  String?
  adsetId     String?
  adIds       String   @default("") // comma separated
  creativeIds String   @default("")
  error       String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Every external API call and every approved or blocked action.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  actor      String // helix | user | cron
  action     String // e.g. meta.api, meta.connect, meta.draft
  target     String
  outcome    String // ok | error | blocked | retry
  httpStatus Int?
  detail     String   @default("{}")
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

// A seasonal prep plan the user added with one click (see src/lib/seasons.ts).
model SeasonPlan {
  id        String   @id @default(cuid())
  userId    String
  planKey   String // e.g. "black-friday-2026"
  addedOn   String // YYYY-MM-DD in the user's time zone
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, planKey])
}

// ---------- Suppliers and stock (src/lib/stock.ts) ----------
model Supplier {
  id           String      @id @default(cuid())
  userId       String
  name         String
  contact      String      @default("")
  country      String      @default("")
  kind         String      @default("unknown") // factory | trading | unknown
  moq          Int         @default(0)
  leadTimeDays Int         @default(45)
  paymentTerms String      @default("")
  notes        String      @default("")
  example      Boolean     @default(false)
  createdAt    DateTime    @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items        StockItem[]

  @@index([userId])
}

model StockItem {
  id             String    @id @default(cuid())
  userId         String
  sku            String
  name           String
  supplierId     String?
  unitCost       Float     @default(0)
  freightPerUnit Float     @default(0)
  dutyPct        Float     @default(0)
  otherPerUnit   Float     @default(0)
  onHand         Int       @default(0)
  onOrder        Int       @default(0)
  dailySales     Float     @default(0) // units a day; typed today, synced from Shopify later
  leadTimeDays   Int? // overrides the supplier lead time
  safetyDays     Int       @default(14)
  example        Boolean   @default(false)
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  @@unique([userId, sku])
}

/// Ticked steps in Learn lessons ("7.1#3" = lesson 7.1, step 3). Also kept in the browser.
model LessonProgress {
  userId  String
  stepKey String
  doneAt  DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, stepKey])
}

/// The Helix Course: which goal the user is on. Task ticks live in TaskCompletion (ids start with "course-").
model CourseState {
  userId      String   @id
  track       String   @default("growing") // "starting" | "growing" | "scaling"
  goalId      String   @default("")
  doneGoals   String   @default("") // comma-separated goal ids, in the order finished
  confirmed   String   @default("") // goals the user confirmed themselves
  baselineAov Float    @default(0) // AOV when the current goal started (for "raise AOV by 10%")
  celebrate   String? // goal id just finished, cleared once the celebration is seen
  cardDeck    String   @default("") // card player: current deck ("setup" or a lesson ref like "7.1")
  cardIndex   Int      @default(0) // card player: card within that deck
  cardDay     String   @default("") // YYYY-MM-DD of cardsToday
  cardsToday  Int      @default(0) // cards moved past on cardDay
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Profit setup: the unit costs behind profit per order (Goal 1 of the course).
model ProfitSetup {
  userId            String   @id
  productName       String   @default("") // what they sell, from the "I'm lost" walkthrough
  price             Float    @default(0)
  productCost       Float    @default(0)
  freightDuty       Float    @default(0)
  packaging         Float    @default(0)
  shipToCustomer    Float    @default(0)
  feePct            Float    @default(1.75)
  feeFixed          Float    @default(0.3)
  marketingPerOrder Float    @default(0)
  subscriptions     Float    @default(0)
  otherFixed        Float    @default(0)
  ordersPerMonth    Int      @default(0)
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Compact progress events for the history page (goal finished, profit setup saved). Ticks live in TaskCompletion and LessonProgress.
model ProgressEvent {
  id     String   @id @default(cuid())
  userId String
  kind   String // "goal_done" | "profit_setup"
  ref    String   @default("")
  at     DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, at])
}

// One store check: plain server fetches of the home page, a product page and the cart, then heuristics.
model AuditRun {
  id         String    @id @default(cuid())
  userId     String
  url        String
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  findings   Json // Finding[]: quote, severity, fix, lesson link
  facts      Json? // what was seen, used to compare month to month
  error      String?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startedAt])
}

// ---------- Shopify integration ----------
// Offline access token, stored only as AES-256-GCM ciphertext (src/lib/crypto.ts). Aggregates only: no customer names, emails or addresses.
model ShopifyConnection {
  userId        String    @id
  shop          String // example.myshopify.com
  tokenEnc      String
  scopes        String    @default("")
  shopName      String    @default("")
  currency      String?
  productCount  Int       @default(0)
  status        String    @default("active") // active | error | uninstalled
  lastSyncAt    DateTime?
  lastSyncError String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([shop])
}

// ---------- Google Ads integration ----------
// Refresh token stored only as AES-256-GCM ciphertext.
model GoogleAdsConnection {
  userId          String    @id
  googleEmail     String    @default("")
  tokenEnc        String
  scopes          String    @default("")
  customerId      String? // 1234567890, no dashes
  customerName    String?
  loginCustomerId String?
  currency        String?
  status          String    @default("active") // active | error | expired
  lastSyncAt      DateTime?
  lastSyncError   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model GoogleAdsSnapshot {
  userId   String   @id
  data     String
  syncedAt DateTime @default(now())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Paused Google Ads campaigns Helix created after an approval.
model GoogleAdsDraft {
  id         String   @id @default(cuid())
  userId     String
  approvalId String?
  status     String // created | failed
  campaignId String?
  budgetId   String?
  error      String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ---------- AI usage ----------
// One row per AI call (or cache hit). Drives per-user monthly caps and the global spend kill-switch.
model AiUsage {
  id           String   @id @default(cuid())
  userId       String
  kind         String // audit | adcopy | help
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  cached       Boolean  @default(false)
  ok           Boolean  @default(true)
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model AiCache {
  key       String   @id // sha256 of kind + prompt
  userId    String
  kind      String
  text      String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Weekly Wins wall: members share a small win; it shows only after a moderator approves it.
model Win {
  id        String    @id @default(cuid())
  userId    String
  text      String
  firstName String    @default("")
  weekOf    String // YYYY-MM-DD, the Monday of the week it was shared
  status    String    @default("pending") // "pending" | "approved" | "rejected"
  createdAt DateTime  @default(now())
  decidedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status, weekOf])
  @@index([userId])
}

/// "Review my store" requests (also emailed to support).
model ReviewRequest {
  id        String   @id @default(cuid())
  userId    String
  storeUrl  String
  question  String   @default("")
  emailed   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/// Achievements the user has already been shown a celebration for.
model AchievementSeen {
  userId String
  key    String
  seenAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, key])
}

/// A discount Helix prepared for a seasonal event. It stays a draft until the user approves and sets it up.
model PromoDraft {
  id        String   @id @default(cuid())
  userId    String
  eventKey  String // e.g. "black-friday-2026"
  code      String
  percent   Int
  startsOn  String // YYYY-MM-DD
  endsOn    String // YYYY-MM-DD
  status    String   @default("draft") // "draft" | "approved" | "dismissed"
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventKey])
}

// ---------- Billing webhook ledger: each Stripe event id is processed once ----------
model StripeEvent {
  id          String   @id // evt_...
  type        String
  processedAt DateTime @default(now())
}

// ---------- Email preferences and send log ----------
// Marketing emails (daily tasks, events, win-back, scorecard) can be switched off; transactional ones cannot.
model EmailPrefs {
  userId     String   @id
  dailyTasks Boolean? // null = default (on for paid plans, off for Free)
  events     Boolean  @default(true)
  winback    Boolean  @default(true)
  scorecard  Boolean  @default(true)
  alerts     Boolean  @default(true) // low cash, reorder and break-even alerts by email
  timezone   String   @default("Australia/Sydney")
  unsubToken String   @unique @default(cuid())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model EmailSent {
  id     String   @id @default(cuid())
  userId String
  kind   String // welcome | daily | event | receipt | failed | cancel | winback | scorecard
  key    String // makes each send unique, e.g. the date or invoice id
  sentAt DateTime @default(now())
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
}

// ---------- Planning tools ----------
/// Manual inputs only where no synced data exists (bank balance, cash floor, yearly goal, store type).
model ToolInput {
  userId    String
  kind      String // cash | forecast | store
  data      Json
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

/// Daily recalculated results (forecast, cash, buy plan, customers, targets, ad check).
model ToolSnapshot {
  userId     String
  kind       String
  data       Json
  computedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, kind])
}

/// Alerts that become Today tasks (and an optional email): low cash, reorder, product under break-even, ad check fixes.
model ToolAlert {
  id         String    @id @default(cuid())
  userId     String
  key        String // e.g. cash-2026-11-02, reorder-SKU1, product-SKU2, adcheck-2026-10-pixel
  kind       String // cash | reorder | product | adcheck
  title      String
  why        String
  href       String
  createdOn  String // YYYY-MM-DD
  resolvedAt DateTime?
  emailed    Boolean   @default(false)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}

model WeeklyReview {
  id      String   @id @default(cuid())
  userId  String
  week    String // Monday, YYYY-MM-DD
  data    Json // the five numbers as shown
  flagged String?
  fixId   String?
  fixText String?
  savedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, week])
}

/// Lasting limits shared by every server. One row per hit; the key is never raw personal data (IPs are hashed).
model RateHit {
  id        String   @id @default(cuid())
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
}

/// Short locks shared by every server, e.g. one store check at a time per user. Expired leases can be taken over.
model Lease {
  key   String   @id
  until DateTime
}

// ---------- Helix AI coach (additive, 27 Oct 2026) ----------
/// Retrieval chunks of the Helix-worded lesson library. Filled by scripts/coach-embed.ts. Embedding is pgvector, tsv is for keyword (BM25-style) search.
model CoachChunk {
  id        String                       @id // source:slug:ref:n
  source    String // playbook | sop | card | extra
  slug      String
  lessonRef String?
  stage     String
  title     String
  href      String // Helix lesson link that answers cite
  text      String
  hash      String // sha of title+text: re-embed only changed chunks
  tokens    Int                          @default(0)
  embedding Unsupported("vector(768)")?
  tsv       Unsupported("tsvector")?
  updatedAt DateTime                     @updatedAt

  @@index([slug])
}

/// One row per coach message. Drives per-user fair-use limits, deep-tier limits and the hard monthly cap. Prompt and answer are stored redacted.
model CoachUsage {
  id           String   @id @default(cuid())
  userId       String
  tier         String // fast | deep
  mode         String // store | course | general
  why          String // deep-dive | multi-step | big-context | self-check | default
  model        String
  inputTokens  Int      @default(0)
  cachedTokens Int      @default(0)
  outputTokens Int      @default(0)
  costUsd      Float    @default(0)
  topScore     Float    @default(0)
  ok           Boolean  @default(true)
  question     String // redacted, max 1000 chars
  answer       String // redacted, max 4000 chars
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

/// What the coach remembers about a user's business (never customer PII). Kept across days; the user can edit or delete each fact.
model CoachMemory {
  id        String   @id @default(cuid())
  userId    String
  kind      String // business | store | products | channels | goals | budget | decisions | tried | results
  key       String // short slug; same kind+key updates the fact
  fact      String
  source    String   @default("chat") // chat | user
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, key])
  @@index([userId])
}

/// Chat messages, grouped by day (Sydney date). The widget shows only today's; older days stay for the user's own record and memory.
model CoachMessage {
  id        String   @id @default(cuid())
  userId    String
  day       String // YYYY-MM-DD
  role      String // user | coach
  text      String // redacted
  meta      Json? // mode, tier, links
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, day])
}

/// The coach's 1-3 suggested tasks for a day. Open tasks are followed up the next day.
model CoachTask {
  id     String    @id @default(cuid())
  userId String
  day    String // YYYY-MM-DD
  key    String
  title  String
  href   String
  why    String    @default("")
  doneAt DateTime?
  user   User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day, key])
  @@index([userId, day])
}

// TikTok Ads (additive, behind TIKTOK_ADS=1). Long-lived Marketing API token, encrypted. Daily spend sync only.
model TikTokConnection {
  userId        String    @id
  advertiserId  String?
  advertiserIds String    @default("") // comma list returned at connect
  tokenEnc      String
  status        String    @default("active") // active | error | expired
  lastSyncAt    DateTime?
  lastSyncError String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// GA4 sessions (additive, behind GA4_SESSIONS=1). Uses the Google connection's token with analytics.readonly.
model Ga4Property {
  userId        String    @id
  propertyId    String // numeric GA4 property id
  lastSyncAt    DateTime?
  lastSyncError String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}
